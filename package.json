{
  "name": "niftispy",
  "displayName": "NiftiSpy",
  "description": "High-performance NIfTI medical image viewer with streaming, Range requests, and WebWorker parsing",
  "version": "2.3.3",
  "publisher": "MaiwulanjiangMaiming",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaiwulanjiangMaiming/NiftiSpy"
  },
  "license": "MIT",
  "icon": "Icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "nifti",
    "nii",
    "medical imaging",
    "neuroimaging",
    "brain",
    "mri",
    "numpy",
    "npy",
    "npz",
    "nrrd",
    "mrc",
    "mgh",
    "dicom",
    "dicom viewer",
    "medical image viewer",
    "viewer"
  ],
  "homepage": "https://github.com/MaiwulanjiangMaiming/NiftiSpy",
  "bugs": {
    "url": "https://github.com/MaiwulanjiangMaiming/NiftiSpy/issues"
  },
  "activationEvents": [
    "onCustomEditor:niftispy.nifti",
    "onCustomEditor:niftispy.zarr"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "niftispy.nifti",
        "displayName": "NiftiSpy",
        "selector": [
          {
            "filenamePattern": "*.nii"
          },
          {
            "filenamePattern": "*.nii.gz"
          },
          {
            "filenamePattern": "*.hdr"
          },
          {
            "filenamePattern": "*.npy"
          },
          {
            "filenamePattern": "*.npz"
          },
          {
            "filenamePattern": "*.nrrd"
          },
          {
            "filenamePattern": "*.nhdr"
          },
          {
            "filenamePattern": "*.mha"
          },
          {
            "filenamePattern": "*.mhd"
          },
          {
            "filenamePattern": "*.mrc"
          },
          {
            "filenamePattern": "*.mrcs"
          },
          {
            "filenamePattern": "*.mgz"
          },
          {
            "filenamePattern": "*.mgh"
          },
          {
            "filenamePattern": "*.dcm"
          },
          {
            "filenamePattern": "*.dicom"
          },
          {
            "filenamePattern": "*.ima"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "niftispy.zarr",
        "displayName": "NiftiSpy (Zarr metadata)",
        "selector": [
          {
            "filenamePattern": "*.zarr"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "niftispy.raw",
        "displayName": "NiftiSpy (raw + header)",
        "selector": [
          {
            "filenamePattern": "*.raw"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "nifti",
        "aliases": [
          "NIfTI"
        ],
        "extensions": [
          ".nii",
          ".nii.gz",
          ".hdr"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      },
      {
        "id": "numpy-volume",
        "aliases": [
          "NumPy Array"
        ],
        "extensions": [
          ".npy",
          ".npz"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      },
      {
        "id": "volume",
        "aliases": [
          "Volume"
        ],
        "extensions": [
          ".nrrd",
          ".nhdr",
          ".mha",
          ".mhd",
          ".mrc",
          ".mrcs",
          ".mgz",
          ".mgh",
          ".dcm",
          ".dicom",
          ".ima"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      },
      {
        "id": "zarr",
        "aliases": [
          "Zarr"
        ],
        "extensions": [
          ".zarr"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      }
    ],
    "keybindings": [
      {
        "key": "alt+up",
        "command": "niftispy.scrollSliceUp",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      },
      {
        "key": "alt+down",
        "command": "niftispy.scrollSliceDown",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      },
      {
        "key": "alt+a",
        "command": "niftispy.setViewAxial",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      },
      {
        "key": "alt+c",
        "command": "niftispy.setViewCoronal",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      },
      {
        "key": "alt+s",
        "command": "niftispy.setViewSagittal",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      },
      {
        "key": "alt+r",
        "command": "niftispy.resetView",
        "when": "activeCustomEditorId == 'niftispy.nifti'"
      }
    ],
    "commands": [
      {
        "command": "niftispy.toggleDebugMode",
        "title": "NiftiSpy: Toggle Debug Mode",
        "category": "NiftiSpy"
      }
    ],
    "configuration": {
      "title": "NiftiSpy",
      "properties": {
        "niftispy.proxyPort": {
          "type": "number",
          "default": 0,
          "description": "HTTP proxy port (0 = auto assign)"
        },
        "niftispy.volumeCacheBudgetMB": {
          "type": "number",
          "default": 1024,
          "minimum": 128,
          "description": "Host memory budget for fully decoded volumes (MiB). Reopen the editor or reload the window to apply."
        },
        "niftispy.mniTemplatePath": {
          "type": "string",
          "default": "",
          "description": "Path to the MNI standard template volume used by the 'To MNI' registration button (e.g. MNI152_T1_2mm.nii.gz). Remembered after the first selection."
        },
        "niftispy.defaultColormap": {
          "type": "string",
          "default": "gray",
          "enum": [
            "gray",
            "hot",
            "cool",
            "viridis",
            "jet",
            "inferno"
          ],
          "description": "Default colormap"
        },
        "niftispy.enableLOD": {
          "type": "boolean",
          "default": true,
          "description": "Enable progressive LOD loading for .nii.gz"
        },
        "niftispy.previewMode": {
          "type": "string",
          "default": "binary",
          "enum": [
            "binary",
            "json"
          ],
          "description": "Preview transport format"
        },
        "niftispy.renderBackend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "webgl",
            "canvas"
          ],
          "description": "Slice rendering backend"
        },
        "niftispy.fullVolumePolicy": {
          "type": "string",
          "default": "adaptive",
          "enum": [
            "adaptive",
            "manual",
            "debounced",
            "eager"
          ],
          "description": "When to load the full volume. adaptive: small and local files load immediately; medium files on a fast link debounce a background download; large files and slow links stay on slices until MIP or registration needs voxels."
        },
        "niftispy.nativeAcceleration": {
          "type": "string",
          "default": "auto",
          "enum": [
            "off",
            "auto",
            "force"
          ],
          "description": "Native acceleration policy"
        },
        "niftispy.showPerfReport": {
          "type": "boolean",
          "default": false,
          "description": "Initial state of debug mode. Once the extension is active, click the $(bug) NiftiSpy Debug status bar item to toggle perf reports on/off interactively. This setting is read only once at startup."
        },
        "niftispy.remoteCacheBudgetMB": {
          "type": "number",
          "default": 4096,
          "minimum": 0,
          "description": "Disk budget in MiB for seekable remote gzip caches and previews. Old entries are evicted by last access. Set to 0 to use gzip indexes without an unpacked cache."
        },
        "niftispy.remoteCacheDirectory": {
          "type": "string",
          "default": "",
          "description": "Remote extension-host directory for gzip caches. Empty uses the host temporary directory. Original images are never modified."
        }
      }
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap",
    "build:viewer": "esbuild webview/viewer.ts --bundle --platform=browser --target=es2020 --outfile=dist/viewer.js --sourcemap",
    "build:worker": "esbuild webview/worker.ts --bundle --platform=browser --target=es2020 --outfile=dist/worker.js --sourcemap",
    "build:regworker": "esbuild webview/regWorker.ts --bundle --platform=browser --target=es2020 --outfile=dist/regWorker.js --sourcemap",
    "build": "npm run build:ext && npm run build:viewer && npm run build:worker && npm run build:regworker",
    "build:prod:ext": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap --minify",
    "build:prod:viewer": "esbuild webview/viewer.ts --bundle --platform=browser --target=es2020 --outfile=dist/viewer.js --sourcemap --minify",
    "build:prod:worker": "esbuild webview/worker.ts --bundle --platform=browser --target=es2020 --outfile=dist/worker.js --sourcemap --minify",
    "build:prod:regworker": "esbuild webview/regWorker.ts --bundle --platform=browser --target=es2020 --outfile=dist/regWorker.js --sourcemap --minify",
    "build:prod": "npm run build:prod:ext && npm run build:prod:viewer && npm run build:prod:worker && npm run build:prod:regworker",
    "build:native": "node scripts/build-native.js",
    "build:wasm": "wasm-pack build native-wasm --target web --out-dir ../webview/wasm --out-name niftispy_wasm -- --features simd128 2>/dev/null || wasm-pack build native-wasm --target web --out-dir ../webview/wasm --out-name niftispy_wasm",
    "watch": "concurrently \"npm run build:ext -- --watch\" \"npm run build:viewer -- --watch\" \"npm run build:worker -- --watch\" \"npm run build:regworker -- --watch\"",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "test": "node --test tests/*.test.js",
    "bench:load": "node benchmarks/load-benchmark.js",
    "bench:multi": "node benchmarks/multi-load-benchmark.js",
    "bench:remote": "node benchmarks/remote-sim-benchmark.js",
    "lint": "eslint src/**/*.ts webview/**/*.ts",
    "format": "prettier --write 'src/**/*.ts' 'webview/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'webview/**/*.ts'",
    "bench:host": "node benchmarks/remote-gzip-profile.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@webgpu/types": "^0.1.70",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pako": "^3.0.1"
  }
}
