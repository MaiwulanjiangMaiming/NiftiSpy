{
  "name": "niftispy",
  "displayName": "NiftiSpy",
  "description": "High-performance NIfTI medical image viewer with streaming, Range requests, and WebWorker parsing",
  "version": "2.0.0",
  "publisher": "MaiwulanjiangMaiming",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaiwulanjiangMaiming/NiftiSpy"
  },
  "license": "MIT",
  "icon": "Icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Machine Learning"
  ],
  "keywords": [
    "nifti",
    "nii",
    "medical imaging",
    "neuroimaging",
    "brain",
    "mri",
    "viewer"
  ],
  "homepage": "https://github.com/MaiwulanjiangMaiming/NiftiSpy",
  "bugs": {
    "url": "https://github.com/MaiwulanjiangMaiming/NiftiSpy/issues"
  },
  "activationEvents": [
    "onCustomEditor:niftispy.nifti",
    "onCustomEditor:niftispy.zarr"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "niftispy.nifti",
        "displayName": "NiftiSpy",
        "selector": [
          {
            "filenamePattern": "*.nii"
          },
          {
            "filenamePattern": "*.nii.gz"
          },
          {
            "filenamePattern": "*.hdr"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "niftispy.zarr",
        "displayName": "NiftiSpy (Zarr)",
        "selector": [
          {
            "filenamePattern": "*.zarr"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "nifti",
        "aliases": [
          "NIfTI"
        ],
        "extensions": [
          ".nii",
          ".nii.gz",
          ".hdr"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      },
      {
        "id": "zarr",
        "aliases": [
          "Zarr"
        ],
        "extensions": [
          ".zarr"
        ],
        "icon": {
          "light": "./File-Icons-clean.png",
          "dark": "./File-Icons-clean.png"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "niftispy-icons",
        "label": "NiftiSpy File Icons",
        "path": "./dist/niftispy-icon-theme.json"
      }
    ],
    "keybindings": [
      { "key": "alt+up", "command": "niftispy.scrollSliceUp", "when": "activeCustomEditorId == 'niftispy.nifti'" },
      { "key": "alt+down", "command": "niftispy.scrollSliceDown", "when": "activeCustomEditorId == 'niftispy.nifti'" },
      { "key": "alt+a", "command": "niftispy.setViewAxial", "when": "activeCustomEditorId == 'niftispy.nifti'" },
      { "key": "alt+c", "command": "niftispy.setViewCoronal", "when": "activeCustomEditorId == 'niftispy.nifti'" },
      { "key": "alt+s", "command": "niftispy.setViewSagittal", "when": "activeCustomEditorId == 'niftispy.nifti'" },
      { "key": "alt+r", "command": "niftispy.resetView", "when": "activeCustomEditorId == 'niftispy.nifti'" }
    ],
    "configuration": {
      "title": "NiftiSpy",
      "properties": {
        "niftispy.proxyPort": {
          "type": "number",
          "default": 0,
          "description": "HTTP proxy port (0 = auto assign)"
        },
        "niftispy.defaultColormap": {
          "type": "string",
          "default": "gray",
          "enum": [
            "gray",
            "hot",
            "cool",
            "viridis",
            "jet",
            "inferno"
          ],
          "description": "Default colormap"
        },
        "niftispy.enableLOD": {
          "type": "boolean",
          "default": true,
          "description": "Enable progressive LOD loading for .nii.gz"
        },
        "niftispy.previewMode": {
          "type": "string",
          "default": "binary",
          "enum": [
            "binary",
            "json"
          ],
          "description": "Preview transport format"
        },
        "niftispy.renderBackend": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "webgl",
            "canvas"
          ],
          "description": "Slice rendering backend"
        },
        "niftispy.fullVolumePolicy": {
          "type": "string",
          "default": "debounced",
          "enum": [
            "manual",
            "debounced",
            "eager"
          ],
          "description": "When to trigger full-volume loading"
        },
        "niftispy.nativeAcceleration": {
          "type": "string",
          "default": "auto",
          "enum": [
            "off",
            "auto",
            "force"
          ],
          "description": "Native acceleration policy"
        }
      }
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --sourcemap",
    "build:viewer": "esbuild webview/viewer.ts --bundle --platform=browser --target=es2020 --outfile=dist/viewer.js --sourcemap",
    "build:worker": "esbuild webview/worker.ts --bundle --platform=browser --target=es2020 --outfile=dist/worker.js --sourcemap",
    "build": "npm run build:ext && npm run build:viewer && npm run build:worker",
    "build:native": "node scripts/build-native.js",
    "watch": "concurrently \"npm run build:ext -- --watch\" \"npm run build:viewer -- --watch\" \"npm run build:worker -- --watch\"",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "node --test tests/*.test.js",
    "bench:load": "node benchmarks/load-benchmark.js",
    "bench:multi": "node benchmarks/multi-load-benchmark.js",
    "bench:remote": "node benchmarks/remote-sim-benchmark.js",
    "lint": "eslint src/**/*.ts webview/**/*.ts",
    "format": "prettier --write 'src/**/*.ts' 'webview/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'webview/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@webgpu/types": "^0.1.70",
    "concurrently": "^8.2.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
